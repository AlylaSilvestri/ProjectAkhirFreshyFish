<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bentuk sudut rounded -->
    <corners android:radius="12dp" />

    <!-- Warna latar belakang -->
    <solid android:color="@android:color/white" />

    <!-- Border atau garis pinggir -->
    <stroke
        android:width="2dp"
        android:color="#CCCCCC" /> <!-- Warna border abu-abu terang -->

    <!-- Padding dalam -->
    <padding
        android:left="10dp"
        android:top="10dp"
        android:right="10dp"
        android:bottom="10dp" />
</shape>
