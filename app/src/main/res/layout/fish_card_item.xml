 <RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true">

    <!-- Top Section with User Greeting and Search -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#0099CC">

        <!-- Greeting and Search Section -->
        <TextView
            android:id="@+id/greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hi, User"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/search"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Search"
                android:padding="10dp"
                android:background="@drawable/search_background" />

            <ImageButton
                android:id="@+id/search_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/baseline_search_24"
                android:background="?android:attr/selectableItemBackground" />
        </LinearLayout>
    </LinearLayout>

    <!-- TableLayout for Product Grid -->

    <!-- Bottom Navigation -->
    <TableLayout
        android:id="@+id/product_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/greeting"
        android:layout_marginTop="285dp"
        android:padding="16dp"
        tools:ignore="NotSibling">

        <!-- First Row -->
        <TableRow>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <!-- Fish Image -->
                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_margin="8dp"
                    android:src="@drawable/gurame" />

                <!-- Fish Name -->
                <TextView
                    android:id="@+id/fish_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ikan Gurame"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_gravity="center"
                    android:paddingTop="8dp" />

                <!-- Fish Description -->
                <TextView
                    android:id="@+id/fish_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lorem Ipsum is simply dummy text"
                    android:textSize="14sp"
                    android:textColor="#808080"
                    android:layout_gravity="center"
                    android:paddingTop="4dp" />

                <!-- Fish Price -->
                <TextView
                    android:id="@+id/fish_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp 100.000"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#00FF00"
                    android:layout_gravity="center"
                    android:paddingTop="8dp" />
            </LinearLayout>

            <!-- Repeat the same for other images -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_margin="8dp"
                    android:src="@drawable/gurame" />

                <TextView
                    android:id="@+id/fish_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ikan Gurame"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_gravity="center"
                    android:paddingTop="8dp" />

                <TextView
                    android:id="@+id/fish_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lorem Ipsum is simply dummy text"
                    android:textSize="14sp"
                    android:textColor="#808080"
                    android:layout_gravity="center"
                    android:paddingTop="4dp" />

                <TextView
                    android:id="@+id/fish_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp 100.000"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#00FF00"
                    android:layout_gravity="center"
                    android:paddingTop="8dp" />
            </LinearLayout>

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_margin="8dp"
                    android:src="@drawable/gurame" />

                <TextView
                    android:id="@+id/fish_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ikan Gurame"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_gravity="center"
                    android:paddingTop="8dp" />

                <TextView
                    android:id="@+id/fish_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lorem Ipsum is simply dummy text"
                    android:textSize="14sp"
                    android:textColor="#808080"
                    android:layout_gravity="center"
                    android:paddingTop="4dp" />

                <TextView
                    android:id="@+id/fish_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp 100.000"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#00FF00"
                    android:layout_gravity="center"
                    android:paddingTop="8dp" />
            </LinearLayout>

            <!-- Repeat the same for the third image in this row -->
        </TableRow>

        <!-- Second Row -->
        <TableRow>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_margin="8dp"
                    android:src="@drawable/lele" />

                <TextView
                    android:id="@+id/fish_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ikan Lele"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_gravity="center"
                    android:paddingTop="8dp" />

                <TextView
                    android:id="@+id/fish_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lorem Ipsum is simply dummy text"
                    android:textSize="14sp"
                    android:textColor="#808080"
                    android:layout_gravity="center"
                    android:paddingTop="4dp" />

                <TextView
                    android:id="@+id/fish_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp 50.000"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#00FF00"
                    android:layout_gravity="center"
                    android:paddingTop="8dp" />
            </LinearLayout>

            <!-- Repeat for other images in the row -->
        </TableRow>

        <!-- Third Row -->
        <TableRow>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_margin="8dp"
                    android:src="@drawable/nila" />

                <TextView
                    android:id="@+id/fish_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ikan Nila"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_gravity="center"
                    android:paddingTop="8dp" />

                <TextView
                    android:id="@+id/fish_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lorem Ipsum is simply dummy text"
                    android:textSize="14sp"
                    android:textColor="#808080"
                    android:layout_gravity="center"
                    android:paddingTop="4dp" />

                <TextView
                    android:id="@+id/fish_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp 80.000"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#00FF00"
                    android:layout_gravity="center"
                    android:paddingTop="8dp" />
            </LinearLayout>

            <!-- Repeat for other images in the row -->
        </TableRow>
    </TableLayout>

    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:weightSum="3"
        android:background="#0099CC">

        <ImageButton
            android:id="@+id/home_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/baseline_home_24"
            android:background="?android:attr/selectableItemBackground" />

        <ImageButton
            android:id="@+id/cart_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/baseline_shopping_cart_24"
            android:background="?android:attr/selectableItemBackground" />

        <ImageButton
            android:id="@+id/profile_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/baseline_person_24"
            android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>
</RelativeLayout>
